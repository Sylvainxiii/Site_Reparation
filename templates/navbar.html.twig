		{% endif %}
		{% if not app.user %}
			<li class="navbar-item flex-row">
				<a class="navbar-link" href="{{path('app_login')}}">Se Connecter</a>
			</li>
		{% else %}
			<li class="navbar-item flex-row">
				<a class="navbar-icon flex-row center" href="{{path('app_logout')}}"><img id="navbar-logout" width='30px' src='/logo/exit-logout.svg'/></a>
			</li>
		{% endif %}
