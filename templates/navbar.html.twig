<input type="checkbox" id="navbar-bouton"/>
<label for="navbar-bouton" class="navbar-bouton">
	<span></span>
	<span></span>
	<span></span>
</label>


<nav class="flex-row-responsive grad">
	<a class="navbar-icon flex-row center" href="/">
		<img src="/logo/logo.svg" alt="" class="navbar-logo">
	</a>

	<ul class="navbar-list flex-row-responsive flex-end">
		<li class="navbar-item flex-row">
			<a class="navbar-link" aria-current="page" href="/intervention/new">Réparer!</a>
		</li>
		{% if app.user %}
			<li class="navbar-item flex-row">
				<a class="navbar-link" href="/intervention/">Mes Fiches</a>
			</li>
			<li class="navbar-item flex-row">
				<a class="navbar-link" href="{{path('app_fr_utilisateur_uti_show', {'id': app.user.id })}}">Mon Profil</a>
