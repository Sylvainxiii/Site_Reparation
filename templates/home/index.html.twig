{% extends 'base.html.twig' %}

{% block title %}Réparations Audio
{% endblock %}

{% block body %}

<div class="flex-start flex-column fond-img">
	<h1 class="orange">N'ayez plus peur de réparer vos appareils!</h1>
	<div class="flex-row center">
		<input type='text' placeholder='Marque, Ref...'>
	</div>
</div>
<div class="center flex-row grad">
	{% for category in fr_categorie_cats %}
		<div class="navbar-item">
			<a class="navbar-link" href="">{{category.CatNom}}</a>
		</div>
	{% endfor %}
</div>

{% if app.user %}
	<div class="center flex-row" id="index-recap">
		<div class="flex-start flex-row orange-border" id="index-recap-fiche">
			<img id="index-recap-fiche-img" src="img/scott-pro-70.jpg">
			<div class="flex-start flex-column" id="index-recap-fiche-txt">
				<h3 class="orange">Ma dernière fiche</h3>
				<p>
					Le résumé succins de ma dernière fiche de réparation. Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
				</p>
				<button class="btn" type="submit">
					Lire la suite...
				</button>
			</div>
		</div>
		<div class="flex-start flex-column" id="index-recap-liste">
			<div class="space-between flex-row recap-element">
				<div>Ampli 1</div>
				<div>25/09/2023</div>
			</div>
			<div class="space-between flex-row recap-element">
				<div>Ampli 1</div>
				<div>25/09/2023</div>
			</div>
			<div class="space-between flex-row recap-element">
				<div>Ampli 2</div>
				<div>25/09/2023</div>
			</div>
			<div class="space-between flex-row recap-element">
				<div>Platine 1</div>
				<div>25/09/2023</div>
			</div>
			<div class="space-between flex-row recap-element">
				<div>Lecteur 1</div>
				<div>25/09/2023</div>
			</div>
		</div>
	</div>
{% else %}
	<div class="flex-start flex-column orange-border" id="index-liste">
		<h3 class="orange">Réparations à la Une</h3>
		<div class="space-between flex-row recap-element">
			<div>Ampli 1</div>
			<div>25/09/2023</div>
		</div>
		<div class="space-between flex-row recap-element">
			<div>Ampli 1</div>
			<div>25/09/2023</div>
		</div>
		<div class="space-between flex-row recap-element">
			<div>Ampli 2</div>
			<div>25/09/2023</div>
		</div>
		<div class="space-between flex-row recap-element">
			<div>Platine 1</div>
			<div>25/09/2023</div>
		</div>
		<div class="space-between flex-row recap-element">
			<div>Lecteur 1</div>
			<div>25/09/2023</div>
		</div>
	</div>
</div>{% endif %}{% endblock %}
